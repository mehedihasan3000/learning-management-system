PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string — database name is set here, not in code:
# e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/learning-management-system?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/learning-management-system

# Secret used to sign and verify admin JWT tokens (use a long random string in production)
JWT_SECRET=change_this_to_a_long_random_secret

# Initial admin account — only used by 'npm run seed' to create the admin document in MongoDB
ADMIN_EMAIL=change_with_admin_email
ADMIN_PASSWORD=change_with_admin_password

# Frontend URL for CORS whitelist (comma-separate multiple origins if needed)
# Local: http://localhost:3000
# Production (Vercel): https://your-frontend.vercel.app
CLIENT_URL=http://localhost:3000
